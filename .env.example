# 复制为 .env 后自行填写。真实 .env 已被 Git 忽略，禁止提交。
# 本地数据库：DATABASE_URL 的密码必须与 POSTGRES_PASSWORD 一致；特殊字符需 URL 编码。
POSTGRES_USER=furniture
POSTGRES_PASSWORD=
POSTGRES_DB=furniture_ai_studio
DATABASE_URL=
# 格式：postgresql://furniture:URL编码后的密码@localhost:5432/furniture_ai_studio

# Auth.js：用 node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))" 生成。
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# 管理员种子：密码至少 12 个字符，UTF-8 编码后不能超过 72 字节。
ADMIN_NAME=管理员
ADMIN_EMAIL=
ADMIN_PASSWORD=

# MinIO 本地账户：密码至少 8 个字符；S3 凭据与这两项保持一致。
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ZenMux：Key 为空自动跳过；生产环境必须使用 Pay As You Go（不能用 Builder Plan）。
ZENMUX_API_KEY=
ZENMUX_BASE_URL=https://zenmux.ai/api/v1
ZENMUX_VERTEX_BASE_URL=https://zenmux.ai/api/vertex-ai
# auto 按路由顺序；zenmux / kie 优先指定网关，失败再换另一家。
GATEWAY_PREFERENCE=auto
# 真实密钥仅填写在被 Git 忽略的 .env 中。
KIE_API_KEY=
# 留空使用官方默认地址 https://api.kie.ai。
KIE_BASE_URL=https://api.kie.ai
# 文件上传与生图使用不同域名。
KIE_UPLOAD_BASE_URL=https://kieai.redpandaai.co
# 本地必须留空，仅预留给部署后的回调地址；当前 worker 仍使用轮询。
KIE_CALLBACK_URL=

# pg-boss 共用 DATABASE_URL；另一个终端执行 npm run worker。
PG_BOSS_SCHEMA=pgboss
# monthlyQuota 单位为美元，默认 $0.50；旧100积分迁移为$0.50。
# 生图和LLM均在调用前锁定用户并校验美元额度；KIE 2K预估$0.030。

# 浏览器验收可选：留空使用本机 Chrome；设为 chromium 时需先安装 Playwright Chromium。
PLAYWRIGHT_CHANNEL=
# NODE_ENV 由 Next.js 自动设置，无需在 .env 手动填写。

# Gemini Google Search仅作文字补充；验证带来源返回后才启用。
GOOGLE_SEARCH_ENABLED=false
