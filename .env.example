# 复制为 .env 后自行填写。真实 .env 已被 Git 忽略，禁止提交。
# 本地数据库：DATABASE_URL 的密码必须与 POSTGRES_PASSWORD 一致；特殊字符需 URL 编码。
POSTGRES_USER=furniture
POSTGRES_PASSWORD=
POSTGRES_DB=furniture_ai_studio
DATABASE_URL=
# 格式：postgresql://furniture:URL编码后的密码@localhost:5432/furniture_ai_studio

# Auth.js：用 node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))" 生成。
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# 管理员种子：密码至少 12 个字符，UTF-8 编码后不能超过 72 字节。
ADMIN_NAME=管理员
ADMIN_EMAIL=
ADMIN_PASSWORD=

# MinIO 本地账户：密码至少 8 个字符；S3 凭据与这两项保持一致。
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# 后续 LLM 对话功能使用，本任务留空。
ZENMUX_API_KEY=
ZENMUX_BASE_URL=
LLM_MODEL=
# 后续 ZenMux Gemini 生图功能使用，具体地址及模型待官方核实。
ZENMUX_IMAGE_BASE_URL=
# 后续 KIE 异步生图使用，具体网关地址及回调地址待配置。
KIE_API_KEY=
KIE_BASE_URL=
KIE_CALLBACK_URL=

# 后续队列使用：pg-boss 共用 DATABASE_URL，本任务不启动任务 worker。
PG_BOSS_SCHEMA=pgboss
# 默认 monthlyQuota 为 100，管理员可在用户管理中修改；当前不执行生成任务。
