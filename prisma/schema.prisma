generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  template_editor
  designer
  viewer
}

enum Complexity {
  simple
  complex
}

enum AssetType {
  photo
  white_bg
  mask
  depth
  generated
  final
  style_ref
}

enum PackStatus {
  draft
  confirmed
  generating
  reviewing
  completed
}

enum SlotType {
  main
  scene
  dimension
  selling_point
  detail
  installation
}

enum JobStatus {
  pending
  running
  success
  failed
  cancelled
}

enum ChatRole {
  user
  assistant
  system
  tool
}

model User {
  id            String          @id @default(cuid())
  name          String
  email         String          @unique
  passwordHash  String
  role          Role            @default(designer)
  department    String?
  monthlyQuota  Decimal         @default(0.5) @db.Decimal(12, 6)
  authVersion   Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  products      Product[]
  assets        Asset[]
  generationJobs GenerationJob[]
  generationBatches GenerationBatch[]
  llmCalls      LlmCall[]
  identityVersions ProductIdentityVersion[]
  documents ProductDocument[]
  profiles ProductProfile[]
  agentSessions AgentSession[]
}

model Product {
  id             String       @id @default(cuid())
  sku            String       @unique
  name           String
  category       String
  dimensions     Json
  materials      String
  colors         Json
  sellingPoints  Json
  complexity     Complexity   @default(simple)
  identityTraits String?      @db.Text
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  assets         Asset[]
  imagePacks     ImagePack[]
  chatMessages   ChatMessage[]
  generationJobs GenerationJob[]
  llmCalls       LlmCall[]
  identityVersions ProductIdentityVersion[]
  documents ProductDocument[]
  profiles ProductProfile[]
  agentSessions AgentSession[]

  @@index([createdById])
}

model Asset {
  id            String       @id @default(cuid())
  productId     String?
  type          AssetType
  storageKey    String       @unique
  width         Int
  height        Int
  createdById   String
  createdAt     DateTime     @default(now())
  sortOrder     Int          @default(0)
  deletedAt     DateTime?
  product       Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdBy     User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  finalSlots    ImageSlot[]  @relation("FinalAsset")
  documents     ProductDocument[]
  templates     Template[]   @relation("ExampleAsset")

  @@index([productId, type])
  @@index([productId, type, deletedAt, sortOrder])
  @@index([createdById])
}

model ImagePack {
  id        String      @id @default(cuid())
  productId String
  status    PackStatus  @default(draft)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  slots     ImageSlot[]
  version   Int         @default(1)
  isCurrent Boolean     @default(true)
  batches   GenerationBatch[]

  @@index([productId])
}

model ImageSlot {
  id           String          @id @default(cuid())
  packId       String
  order        Int
  slotType     SlotType
  goal         String          @db.Text
  method       String
  name         String          @default("图位")
  candidateCount Int           @default(2)
  aspectRatio  String          @default("1:1")
  deletedAt    DateTime?
  finalAssetId String?
  pack         ImagePack       @relation(fields: [packId], references: [id], onDelete: Cascade)
  finalAsset   Asset?          @relation("FinalAsset", fields: [finalAssetId], references: [id], onDelete: SetNull)
  jobs         GenerationJob[]

  @@unique([packId, order])
  @@index([finalAssetId])
}

model Template {
  id             String  @id @default(cuid())
  name           String
  style          String
  room           String
  promptTemplate String  @db.Text
  logicalModel   String
  aspectRatio    String
  exampleAssetId String?
  enabled        Boolean @default(true)
  exampleAsset   Asset?  @relation("ExampleAsset", fields: [exampleAssetId], references: [id], onDelete: SetNull)

  @@index([enabled])
  @@index([exampleAssetId])
}

model GenerationJob {
  id             String     @id @default(cuid())
  slotId         String?
  batchId        String?
  retryOfId      String?    @unique
  retryOf        GenerationJob? @relation("JobRetry", fields: [retryOfId], references: [id], onDelete: Restrict)
  retriedBy      GenerationJob? @relation("JobRetry")
  batch          GenerationBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  productId      String?
  sessionId      String?
  session        AgentSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  logicalModel   String
  provider       String?
  model          String?
  input          Json
  externalTaskId String?
  status         JobStatus  @default(pending)
  cost           Decimal?   @db.Decimal(12, 6)
  costCurrency   String?
  costEstimated  Boolean    @default(false)
  costUsd        Decimal?   @db.Decimal(12, 6)
  credits        Decimal?   @db.Decimal(12, 6)
  reservedUsd    Decimal    @default(0) @db.Decimal(12, 6)
  workerInstanceId String?
  deadlineAt     DateTime?
  reservedCredits Int       @default(0)
  fallback       Boolean    @default(false)
  resultAssetIds Json       @default("[]")
  error          String?    @db.Text
  createdById    String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  startedAt      DateTime?
  completedAt    DateTime?
  nextPollAt     DateTime?
  slot           ImageSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  createdBy      User       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  product        Product?   @relation(fields: [productId], references: [id], onDelete: Restrict)
  attempts       GenerationAttempt[]

  @@index([slotId])
  @@index([batchId])
  @@index([createdById, createdAt])
  @@index([status, createdAt])
  @@index([provider, externalTaskId])
  @@index([productId, createdAt])
}

model GenerationBatch {
  id            String   @id @default(cuid())
  packId        String
  createdById   String
  createdAt     DateTime @default(now())
  slotCount     Int
  totalCount    Int
  estimatedCostUsd Decimal @db.Decimal(12, 6)
  status        String   @default("pending")
  requestKey    String   @unique
  pack          ImagePack @relation(fields: [packId], references: [id], onDelete: Restrict)
  createdBy     User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  jobs          GenerationJob[]
  @@index([packId, createdAt])
}

// 一次付费提交对应一条记录，轮询不另算一次调用。
model GenerationAttempt {
  id             String   @id @default(cuid())
  jobId          String
  provider       String
  model          String
  fallback       Boolean  @default(false)
  status         String   @default("running")
  externalTaskId String?
  durationMs     Int?
  cost           Decimal? @db.Decimal(12, 6)
  currency       String?
  costEstimated  Boolean  @default(false)
  costUsd        Decimal? @db.Decimal(12, 6)
  credits        Decimal? @db.Decimal(12, 6)
  externalGenerationId String?
  billingState   String   @default("none")
  billingChecks  Int      @default(0)
  nextBillingAt  DateTime?
  billingJson    Json?
  usage          Json?
  error          String?  @db.Text
  createdAt      DateTime @default(now())
  completedAt    DateTime?
  job            GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@index([provider, createdAt])
  @@index([jobId, createdAt])
}

model LlmCall {
  id            String   @id @default(cuid())
  sessionId     String?
  session       AgentSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  logicalModel  String
  provider      String
  model         String
  fallback      Boolean  @default(false)
  status        String   @default("running")
  durationMs    Int?
  cost          Decimal? @db.Decimal(12, 6)
  currency      String?
  costEstimated Boolean  @default(false)
  costUsd       Decimal? @db.Decimal(12, 6)
  credits       Decimal? @db.Decimal(12, 6)
  reservedUsd   Decimal  @default(0) @db.Decimal(12, 6)
  externalGenerationId String?
  billingState  String   @default("none")
  billingChecks Int      @default(0)
  nextBillingAt DateTime?
  billingJson   Json?
  inputTokens   Int?
  outputTokens  Int?
  totalTokens   Int?
  error         String?  @db.Text
  createdById   String
  productId     String?
  createdAt     DateTime @default(now())
  completedAt   DateTime?
  createdBy     User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  @@index([provider, createdAt])
  @@index([createdById, createdAt])
}

// 数据库共享熔断状态，网页和 worker 重启后仍可读取；密钥更换后重置。
model GatewayCircuit {
  provider            String   @id
  credentialHash      String
  consecutiveFailures Int      @default(0)
  windowStartedAt     DateTime?
  openUntil           DateTime?
  updatedAt           DateTime @updatedAt
}

// KIE 上传 URL 只有 24 小时有效，按内容和账户缓存 23 小时。
model KieUpload {
  id          String   @id
  url         String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  uploadedAt  DateTime @default(now())
}

// 每次手动保存都留下全文、保存人和时间；生成输入保存所用版本快照。
model ProductIdentityVersion {
  id          String   @id @default(cuid())
  productId   String
  text        String   @db.Text
  savedById   String?
  savedAt     DateTime @default(now())
  historical  Boolean  @default(false)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  savedBy     User?    @relation(fields: [savedById], references: [id], onDelete: Restrict)
  @@index([productId, savedAt])
}

// 跨进程限制所有 KIE 请求的间隔，429 重试也占用名额。
model ProviderRateLimit {
  id            String   @id
  nextAllowedAt DateTime
}

model WorkerHeartbeat {
  id         String   @id
  instanceId String
  processId  Int?
  hostName   String?
  updatedAt  DateTime @updatedAt
}

model ChatMessage {
  id        String   @id @default(cuid())
  productId String
  sessionId String?
  session   AgentSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  requestKey String? @unique
  role      ChatRole
  content   Json
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
}


// 原件保留在私有 MinIO，失败文件也保留解析状态，图片与 Asset 共用原件。
model ProductDocument {
  id String @id @default(cuid())
  productId String
  createdById String
  filename String
  type String
  mime String
  storageKey String @unique
  assetId String?
  imageType String?
  parseStatus String @default("pending")
  text String @default("") @db.Text
  error String?
  createdAt DateTime @default(now())
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  asset Asset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  @@index([productId, createdAt])
}

// 仅美工确认后的正式档案；草稿放在会话中。
model ProductProfile {
  id String @id @default(cuid())
  productId String
  version Int
  data Json
  confirmedById String
  identityVersionId String
  createdAt DateTime @default(now())
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  confirmedBy User @relation(fields: [confirmedById], references: [id], onDelete: Restrict)
  @@unique([productId, version])
}

model AgentSession {
  id String @id @default(cuid())
  productId String
  createdById String
  mode String @default("quick")
  autoConfirm Boolean @default(false)
  firstGenerationConfirmed Boolean @default(false)
  stopQuestions Boolean @default(false)
  profileDraft Json @default("{}")
  draftRevision Int @default(0)
  confirmedProfileId String?
  confirmedPack Boolean @default(false)
  activeSlotId String?
  runningAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  messages ChatMessage[]
  tools AgentToolCall[]
  cards AgentCard[]
  llmCalls LlmCall[]
  jobs GenerationJob[]
  @@unique([productId, createdById])
}

model AgentToolCall {
  id String @id @default(cuid())
  sessionId String
  callId String
  name String
  arguments Json
  result Json?
  status String @default("running")
  error String?
  createdAt DateTime @default(now())
  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@unique([sessionId, callId])
}

model AgentCard {
  id String @id @default(cuid())
  sessionId String
  kind String
  data Json
  status String @default("pending")
  result Json?
  createdAt DateTime @default(now())
  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@index([sessionId, status])
}
